{
  "name": "Send Payment Receipt Email",
  "description": "Sends a professional HTML receipt email to the customer via Gmail whenever a new payment is recorded.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"captured\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Payment"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_payment_receipt_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendPaymentReceipt",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendPaymentReceipt"
  }
}